# ExplainAI Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database URIs
MONGO_URI=mongodb://127.0.0.1:27017/explainai
DATABASE_URL=file:./sql/prisma/dev.db

# Authentication Secrets
JWT_SECRET=ExplainAI@SuperSecretProductionKey2026

# Redis Cache Server
REDIS_URL=redis://127.0.0.1:6379

# AI & LLM Providers
AI_API_KEY=your_gemini_or_openai_api_key_here

# OAuth Credentials
OAUTH_CLIENT_ID=your_google_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Client App URL
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
